# Másold tools/local.env néven, és add meg a két referencia-korpusz (pl. két nagyobb PHP-projekt mappája) útját.
CALLGRAPH_CORPUS_A=/path/to/project-a/app
CALLGRAPH_CORPUS_B=/path/to/project-b/src
# a JSON/MD golden forrása (egy projekt gyökere)
CALLGRAPH_DOC_ROOT=/path/to/project-a
# a JSON/MD golden forrásfájljai (a CALLGRAPH_DOC_ROOT-hoz relatív utak, vesszővel)
CALLGRAPH_DOC_JSON=composer.json,package.json
CALLGRAPH_DOC_MD=README.md
